# Copy to .env (make setup does this if .env is missing). Placeholders only — never commit real values.

# --- Python services (pydantic-settings, prefix MINEOPS_, nested with __) ---
MINEOPS_ENVIRONMENT=local
MINEOPS_LOG__LEVEL=INFO
MINEOPS_LOG__JSON_FORMAT=true

# Migration / seeding connection (schema owner). Local only: this is also the Postgres superuser.
MINEOPS_DB__HOST=localhost
MINEOPS_DB__PORT=5432
MINEOPS_DB__NAME=mineops
MINEOPS_DB__USER=mineops_owner
MINEOPS_DB__PASSWORD=change-me-owner

# --- Least-privilege login roles, created by deploy/compose/initdb/01-roles.sh on first start ---
MINEOPS_APP_RO_PASSWORD=change-me-app-ro
MINEOPS_DRAFTS_RW_PASSWORD=change-me-drafts-rw
MINEOPS_AGENT_RW_PASSWORD=change-me-agent-rw
MINEOPS_GATEWAY_RW_PASSWORD=change-me-gateway-rw

# --- Host ports ---
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
